{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@figma-pixi/shared": [
        "packages/shared/src/index.ts"
      ],
      "@figma-pixi/pixi-runtime": [
        "packages/pixi-runtime/src/index.ts"
      ],
      "@figma-pixi/figma-plugin": [
        "packages/figma-plugin/src/index.ts"
      ]
    }
  }
}
