{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "description": "Inventory and reproducibility contract for the DOM reference renderer used by the retained PixiJS migration. This file does not claim that goldens have been captured.",
  "source": {
    "renderer": "dom",
    "captureStatus": "inventory-only",
    "artifactRoot": "tmp/visual-baselines/dom",
    "freeze": {
      "randomSeed": 20260724,
      "clock": "freeze-after-state-ready",
      "animations": "pause-after-settle",
      "data": "checked-in recipe or documented gap"
    }
  },
  "viewports": [
    {
      "id": "authored-1080x2170",
      "adapter": "chromium",
      "width": 1080,
      "height": 2170,
      "deviceScaleFactor": 1,
      "notes": "Full authored portrait game surface."
    },
    {
      "id": "desktop-fitted-1440x900",
      "adapter": "chromium",
      "width": 1440,
      "height": 900,
      "deviceScaleFactor": 1,
      "notes": "Fitted desktop collision and reflow reference."
    },
    {
      "id": "android-reference",
      "adapter": "android-placeholder",
      "status": "placeholder",
      "width": null,
      "height": null,
      "deviceScaleFactor": null,
      "device": {
        "model": null,
        "androidVersion": null,
        "webViewVersion": null,
        "orientation": "portrait",
        "notes": "Record the agreed physical Android device, native screenshot dimensions, OS build, WebView version, and safe-area insets before approving Android goldens."
      }
    }
  ],
  "settings": {
    "axes": {
      "theme": {
        "values": ["black", "midnight", "witchcraft"],
        "default": "midnight"
      },
      "font": {
        "values": ["lilita-one", "comic-sans-mono"],
        "default": "lilita-one"
      },
      "colorMode": {
        "values": ["resources"],
        "default": "resources"
      },
      "iconMode": {
        "values": ["icons"],
        "default": "icons"
      },
      "progressBar": {
        "values": ["regular", "gradient", "notched"],
        "default": "regular"
      },
      "plotView": {
        "values": ["boxes"],
        "default": "boxes"
      }
    }
  },
  "surfaceDefaults": {
    "viewports": [
      "authored-1080x2170",
      "desktop-fitted-1440x900",
      "android-reference"
    ],
    "settingsCoverage": {
      "mode": "cartesian",
      "axes": ["theme", "font"]
    }
  },
  "comparisonDefaults": {
    "maxChannelDelta": 0,
    "maxDifferentPixels": 0,
    "anchorTolerancePx": 1,
    "glyphEdgeMaxChannelDelta": 40,
    "requireAnchorMetadata": true
  },
  "surfaces": [
    {
      "id": "app.online-gate",
      "label": "server and maintenance gate",
      "kind": "app-gate",
      "production": true,
      "coverage": {
        "globalOwners": ["onlineGateManager"],
        "devUi": ["serverRequired"],
        "domSelectors": [".app-online-gate__dialog"]
      },
      "recipe": {
        "kind": "manual",
        "gap": "No checked-in command currently selects each online, account-in-use, and maintenance reason without changing connection state."
      },
      "anchors": [
        {
          "id": "dialog",
          "selector": ".app-online-gate__dialog",
          "tolerancePx": 1
        }
      ],
      "glyphEdgeMasks": [
        {
          "id": "copy",
          "selector": ".app-online-gate__dialog > .style-box__title, .app-online-gate__message, .app-online-gate__progress-text, .app-online-gate__action",
          "padding": 1,
          "maxChannelDelta": 40
        }
      ],
      "states": [
        {
          "id": "connecting",
          "recipe": { "kind": "devUi", "surfaceId": "serverRequired" }
        },
        { "id": "offline" },
        { "id": "server-paused" },
        { "id": "server-no-energy" },
        { "id": "account-in-use" },
        { "id": "maintenance-drain" },
        { "id": "maintenance-saving" },
        { "id": "maintenance-locked" }
      ]
    },
