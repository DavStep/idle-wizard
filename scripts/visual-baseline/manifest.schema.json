{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idle-wizard.local/schemas/visual-baseline-manifest.schema.json",
  "title": "Idle Wizard visual baseline manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "description",
    "source",
    "viewports",
    "settings",
    "surfaceDefaults",
    "comparisonDefaults",
    "surfaces"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "captureStatus", "artifactRoot", "freeze"],
      "properties": {
        "renderer": { "const": "dom" },
        "captureStatus": { "enum": ["inventory-only", "partial", "complete"] },
        "artifactRoot": { "type": "string", "minLength": 1 },
        "freeze": {
          "type": "object",
          "additionalProperties": false,
          "required": ["randomSeed", "clock", "animations", "data"],
          "properties": {
            "randomSeed": { "type": "integer" },
            "clock": { "type": "string", "minLength": 1 },
            "animations": { "type": "string", "minLength": 1 },
            "data": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/viewport" }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes"],
      "properties": {
        "axes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/settingAxis" }
        }
      }
    },
    "surfaceDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports", "settingsCoverage"],
      "properties": {
        "viewports": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "settingsCoverage": { "$ref": "#/$defs/settingsCoverage" }
      }
    },
    "comparisonDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxChannelDelta",
        "maxDifferentPixels",
        "anchorTolerancePx",
        "glyphEdgeMaxChannelDelta",
        "requireAnchorMetadata"
      ],
      "properties": {
        "maxChannelDelta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "maxDifferentPixels": { "type": "integer", "minimum": 0 },
        "anchorTolerancePx": { "type": "number", "minimum": 0 },
        "glyphEdgeMaxChannelDelta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "requireAnchorMetadata": { "type": "boolean" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "width", "height", "deviceScaleFactor"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "enum": ["chromium", "android-placeholder"] },
        "status": { "enum": ["placeholder", "configured"] },
        "width": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "height": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "deviceScaleFactor": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "null" }
          ]
        },
        "notes": { "type": "string" },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "androidVersion",
            "webViewVersion",
            "orientation",
            "notes"
          ],
          "properties": {
            "model": { "type": ["string", "null"] },
            "androidVersion": { "type": ["string", "null"] },
            "webViewVersion": { "type": ["string", "null"] },
            "orientation": { "enum": ["portrait", "landscape"] },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "settingAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "default"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "default": { "type": "string", "minLength": 1 }
      }
    },
    "settingsCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "axes"],
      "properties": {
        "mode": { "enum": ["defaults", "cartesian"] },
        "axes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": { "$ref": "#/$defs/stringList" },
        "devUi": { "$ref": "#/$defs/stringList" },
        "globalOwners": { "$ref": "#/$defs/stringList" },
        "domSelectors": { "$ref": "#/$defs/stringList" },
        "tutorialSteps": { "$ref": "#/$defs/stringList" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["devUi", "tutorial", "url", "external", "manual"]
        },
        "surfaceId": { "type": "string", "minLength": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "stepIdFromState": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "gap": { "type": "string", "minLength": 1 },
        "options": { "type": "object" },
        "setup": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "args": { "type": "array" }
            }
          }
        },
        "waitFor": { "type": "string", "minLength": 1 },
        "settleMs": { "type": "integer", "minimum": 0 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tolerancePx"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "semanticId": { "type": "string", "minLength": 1 },
        "tolerancePx": { "type": "number", "minimum": 0 },
        "optional": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "anyOf": [
        { "required": ["selector"] },
        { "required": ["semanticId"] }
      ]
    },
    "glyphEdgeMask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "maxChannelDelta"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "rect": { "$ref": "#/$defs/rect" },
        "padding": { "type": "number", "minimum": 0 },
        "maxChannelDelta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "anyOf": [
        { "required": ["selector"] },
        { "required": ["rect"] }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["uncaptured", "captured", "approved"] },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "recipe": { "$ref": "#/$defs/recipe" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" }
        },
        "glyphEdgeMasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/glyphEdgeMask" }
        },
        "baseline": { "$ref": "#/$defs/baseline" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "production",
        "recipe",
        "states"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "app-gate",
            "chrome",
            "dialog",
            "effect",
            "intro",
            "page",
            "preview",
            "tool",
            "tutorial"
          ]
        },
        "production": { "type": "boolean" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "recipe": { "$ref": "#/$defs/recipe" },
        "viewports": { "$ref": "#/$defs/stringList" },
        "settingsCoverage": { "$ref": "#/$defs/settingsCoverage" },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" }
        },
        "glyphEdgeMasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/glyphEdgeMask" }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state" }
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
